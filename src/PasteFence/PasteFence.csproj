<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PasteFence</AssemblyName>
    <RootNamespace>PasteFence</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>PasteFence</Product>
    <Description>AI やチャットへ貼る前に、クリップボードの機密を伏せ字にする常駐ツール</Description>
    <Copyright>Copyright (c) 2026 PasteFence authors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- エクスプローラー・ショートカット・Alt+Tab に出る実行ファイルのアイコン。
         元になった SVG と作り直す手順は docs/icon.md にある。 -->
    <ApplicationIcon>pastefence.ico</ApplicationIcon>

    <!-- 高 DPI の扱い。SystemAware は .NET 8 の WinForms が「指定なし」のときに
         使う値そのもので、ここに書いても今の挙動は何も変わらない。
         将来 SDK の既定値が変わっても勝手に切り替わらないよう固定しているだけ。
         PerMonitorV2 へ上げなかった理由は docs/high-dpi.md に書いた。 -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- トレイと画面でも同じ絵を使うため、実行ファイルに埋め込む（AppIcons.cs が読む） -->
    <EmbeddedResource Include="pastefence.ico" />
    <!-- 実行ファイル単体で落とした人でも動くよう、既定の保護ルールも埋め込む（ConfigLocator.cs が読む） -->
    <EmbeddedResource Include="pastefence-rules.json" />
    <InternalsVisibleTo Include="PasteFence.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Update="pastefence-rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
